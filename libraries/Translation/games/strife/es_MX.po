msgid "TXT_RPLY0_SCRIPT04_D22740_ILLTA"
msgstr "Me arriesgaré."

msgid "TXT_DLG_SCRIPT04_D25772_TELLW"
msgstr "Dile a quien te pregunte que eres el sustituto del Sr. Crispy. Es una tontería, pero funciona. Ah, y quizás quieras echar un vistazo al almacén que está justo encima de nosotros."

msgid "TXT_RPLY0_SCRIPT04_D25772_BOYIH"
msgstr "Ojalá esta identificación funcione."

msgid "TXT_DLG_SCRIPT04_D27288_GETOU"
