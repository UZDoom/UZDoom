msgid "TXT_RPLY0_SCRIPT04_D34868_IMTHE"
msgstr "Soy el trabajador de reemplazo."

msgid "TXT_DLG_SCRIPT04_D36384_ABOUT"
msgstr "Ya era hora de que aparecieras. Ve a hablar con Ketrick en el núcleo. Ah, y toma esta tarjeta de acceso. No queremos que te disparen en tu primer día, ¿eh?"

msgid "TXT_RPLY0_SCRIPT04_D36384_WHERE"
msgstr "¿Dónde está el cristal de energía?"
