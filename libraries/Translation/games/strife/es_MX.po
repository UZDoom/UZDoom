msgid "TXT_RYES0_SCRIPT02_D25772_THEWO"
msgstr "Se dice que… En las alcantarillas albergan algo más que ratas y robots."

msgid "TXT_DLG_SCRIPT02_D27288_WHATC"
msgstr "¿Qué puedo hacer por ti ahora?"

msgid "TXT_RPLY0_SCRIPT02_D27288_MOREI"
