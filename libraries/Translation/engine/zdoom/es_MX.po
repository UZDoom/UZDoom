msgid "QUITMSG"
msgstr ""
"¿Segur@[ao_esp] que quieres\n"
"cerrar este gran juego?"

# In some languages, it may make more sense to translate “Press a key” as
# “Press any key.”
msgid "LOADNET"
msgstr ""
"¡No puedes cargar en una partida en línea!\n"
"\n"
"Presiona cualquier tecla."

msgid "QLOADNET"
msgstr ""
"¡No puedes cargar rápido en una partida en línea!\n"
"\n"
"Presiona cualquier tecla."

msgid "QSAVESPOT"
msgstr ""
"¡No has elegido una ranura para guardado rápido!\n"
"\n"
"Presiona cualquier tecla."

msgid "NEWGAME"
msgstr ""
"No puedes iniciar una nueva\n"
"partida estando en línea.\n"
"\n"
"Presiona cualquier tecla."

msgid "NIGHTMARE"
msgstr ""
"¿Estás segur@[ao_esp]? Esta dificultad\n"
"no es ni remotamente justa.\n"
"\n"
"Presiona Y o N."

msgid "SWSTRING"
msgstr ""
"Esta es la versión shareware de Doom.\n"
"\n"
"Necesitas ordenar la trilogía entera.\n"
"\n"
"Presiona cualquier tecla."

msgid "NETEND"
msgstr ""
"¡No puedes terminar una partida en línea!\n"
"\n"
"Presiona cualquier tecla."

msgid "ENDGAME"
msgstr ""
"¿Estás segur@[ao_esp] de terminar esta partida?\n"
"\n"
"Presiona Y o N."

msgid "RAVENQUITMSG"
msgstr "¿Estás segur@[ao_esp] de que quieres irte?"

